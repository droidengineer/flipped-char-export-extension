{
  "manifest_version": 3,
  "name": "Flipped.Chat Character Exporter",
  "description": "Extracts character data from a flipped.chat character edit page and exports it as Folx-importable JSON.",
  "version": "1.1.1",
  "homepage_url": "https://github.com/droidengineer/flipped-char-export-extension",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://flipped.chat/*"],
  "icons": {
    "32": "icons/icon32-bg.png",
    "64": "icons/icon64-bg.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Export Character to JSON",
    "default_icon": "icons/icon32-action.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "@flipped-aichar-exporter",
      "update_url": "https://github.com/droidengineer/flipped-char-export-extension/raw/main/update.json",
      "data_collection_permissions": {
        "required": ["none"]
      },
      "strict_min_version": "140.0"
    }
  }
}
