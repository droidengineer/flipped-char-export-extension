{
  "manifest_version": 3,
  "name": "Flipped.Chat Character Exporter",
  "version": "1.1.1",
  "description": "Extracts character data from a flipped.chat character edit page and exports it as Folx-importable JSON.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://flipped.chat/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Export Character to JSON",
    "default_icon": {
      "16": "icons-scribe/icon16.png",
      "32": "icons-scribe/icon32.png",
      "48": "icons-scribe/icon48.png",
      "128": "icons-scribe/icon128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "flipped-chat-exporter@example.local",
      "strict_min_version": "109.0"
    }
  }
}
